<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/subtitle"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            style="@style/RowLabel"
            android:layout_marginTop="28dp"
            android:text="@string/label_shizuku" />

        <TextView
            android:id="@+id/shizukuValue"
            style="@style/RowValue"
            android:text="@string/unknown" />

        <TextView
            style="@style/RowLabel"
            android:text="@string/label_permission" />

        <TextView
            android:id="@+id/permissionValue"
            style="@style/RowValue"
            android:text="@string/needed" />

        <TextView
            style="@style/RowLabel"
            android:text="@string/label_hall0" />

        <TextView
            android:id="@+id/hall0Value"
            style="@style/RowValue"
            android:text="@string/waiting" />

        <TextView
            style="@style/RowLabel"
            android:text="@string/label_hall1" />

        <TextView
            android:id="@+id/hall1Value"
            style="@style/RowValue"
            android:text="@string/waiting" />

        <TextView
            style="@style/RowLabel"
            android:text="@string/label_state" />

        <TextView
            android:id="@+id/stateValue"
            style="@style/RowValue"
            android:text="@string/unknown" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorError" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/allowButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/allow_shizuku" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/enableSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/watch_hinge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/footnote"
            android:textAppearance="?attr/textAppearanceBodySmall" />
    </LinearLayout>
</ScrollView>
