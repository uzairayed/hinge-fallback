<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HingeFallback" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#1F6B4A</item>
        <item name="colorOnPrimary">#FFFFFF</item>
    </style>

    <style name="RowLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="RowValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
    </style>
</resources>
